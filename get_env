# Values for Warnings and Info text
# tput is optional: it is missing on minimal systems and fails without $TERM (e.g.
# from cron). Then use $COLUMNS or 80 columns and an ANSI escape to move the cursor.
useTput=""
columns=""
if command -v tput >/dev/null && columns=$(tput cols 2>/dev/null) && [[ "${columns}" =~ ^[0-9]+$ ]]; then
    useTput="yes"
elif [[ "${COLUMNS:-}" =~ ^[0-9]+$ ]]; then
    columns=${COLUMNS}
else
    columns=80
fi
position=$((columns - 10))
# Move the cursor to ${position}, used before [OK] and the like.
tprint() {
    if [ -n "${useTput}" ]; then
        tput hpa "${position}"
    else
        # hpa counts columns from 0, the ANSI escape from 1.
        printf '\033[%sG' "$((position + 1))"
    fi
}
