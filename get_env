# Function to download zip from github.
# Download a URL to a file with ${httpTool}, quiet unless debug.
# Arg: url outFile
httpGet() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local quiet=""
    if [ -z "${debug}" ]; then
        quiet="yes"
    fi
    if [ "${httpTool}" = "curl" ]; then
        # -L: GitHub redirects archive downloads, wget follows redirects by default.
        curl -f -L ${quiet:+-s} -S -o "${2}" "${1}"
    else
        wget ${quiet:+-q} -O "${2}" "${1}"
    fi
}

# Post data to a URL with ${httpTool}, the answer is thrown away.
# Arg: url data
httpPost() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    if [ "${httpTool}" = "curl" ]; then
        curl -f -s -S -o /dev/null --data-raw "${2}" "${1}"
    else
        wget -q -O /dev/null --post-data "${2}" "${1}"
    fi
}

# Download a branch from github as tar.gz and extract it to ${localWorkDir}.
# Arg: server user repository branch
downloadAndExtract() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local server=${1}
    local user=${2}
    local repository=${3}
    local branch=${4}
    local inFile="https://${server}/${user}/${repository}/archive/${branch}.tar.gz"
    local outDir="${downloadDir}/${repository}"
    local outFile="${repository}-${branch}.tar.gz"
    createDir -f -q "${downloadDir}/${repository}"
    foldIt "-n" "Downloading ${inFile}"

    # Download
    if httpGet "${inFile}" "${outDir}/${outFile}"; then
        ok
        dbg "Downloaded ${outFile}"
    else
        failed "Could not download ${inFile}, no internet connection?"
    fi
    foldIt "-n" "Extracting ${outFile}"
    # Extract, verbose if debug
    if tar -x -z ${debug:+-v} -f "${outDir}/${outFile}" -C "${outDir}"; then
        ok
        dbg "Extracted file"
    else
        failed "Failed to extract ${outFile}"
    fi
    foldIt "-n" "Moving files to ${localWorkDir}"
    syncFiles "${outDir}/${repository}-${branch}" "${localWorkDir}/${repository}/${repository}-${branch}"
    # GitHub puts the commit id as "comment=<id>" in the first (pax) header of the tar file.
    local revision
    revision=$(gzip -d -c "${outDir}/${outFile}" 2>/dev/null | head -c 1024 | grep -a -o 'comment=[0-9a-f]*' | cut -d= -f2)
    if ! [[ "${revision}" =~ ^[0-9a-f]{40}$ ]]; then
        dbg "No commit id in ${outFile}"
        revision="unknown"
    fi
    saveRevision "${repository}" "${branch}" "${revision}"
    dbg "${FUNCNAME}() leaving function"
}

# Function to clone and pull repository from gitserver.
# Arg: server user repository branch [ssh port (optional)]
gitCloneAndPull() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    depends git
    local server=${1}
    local user=${2}
    local repository=${3}
    local branch=${4}
    local sshPort=${5:-"22"}
    local gitRemoteRepo="ssh://${user}@${server}:${sshPort}/${pathToRepository}/${repository}"

    createDir -q -f "${localWorkDir}/git"

    # Check if target directory exists.
    if [ -d "${localWorkDir}/git/${repository}" ]; then
        # Check if target is git repository.
        if [ ! -d "${localWorkDir}/git/${repository}/.git" ]; then
            errorExit "${localWorkDir}/git/${repository} is not an git repository."
        fi

        # Check that it is correct repository
        cd "${localWorkDir}/git/${repository}" || errorExit "Could not cd to ${localWorkDir}/git/${repository}"
        local checkedOutrepository=$(git remote -v | grep fetch | awk '{print $2}')
        if ! echo "${checkedOutrepository}" | grep -q "${repository}"; then
            errorExit "Wrong repository: ${localWorkDir}/git/${repository}"
        fi

        # Only fetch here; the wanted branch is fast-forwarded after checkout,
        # otherwise just the currently checked out branch would be updated.
        foldIt "-n" "Git fetch ${repository} to ${localWorkDir}/git/ "
        if git fetch -q; then
            ok
            dbg "Git fetched ${repository} to ${localWorkDir}/git/${repository}"
        else
            failed "Failed to git fetch ${localWorkDir}/git/${repository}"
        fi

    else
        # Local repository does not exists, trying to clone
        cd "${localWorkDir}/git/" || errorExit "Could not cd to ${localWorkDir}/git/"
        dbg "URL to use for git clone:  ${gitRemoteRepo}"
        foldIt "-n" "Git clone ${repository} to ${localWorkDir}/git/ "
        if git clone -q "${gitRemoteRepo}"; then
            ok
            dbg "Clone ${repository} to ${localWorkDir}/git/${repository}"
        else
            failed "Failed to clone ${repository} to ${localWorkDir}/git/${repository}"
        fi
    fi

    gitCheckoutAndSync "${repository}" "${branch}" "update"

    dbg "${FUNCNAME}() leaving function"
}

# Function to checkout a branch in the local clone and sync it to ${localWorkDir}.
# The originally checked out branch is restored afterwards.
# Arg: repository branch [update (optional, fast-forward branch from upstream)]
gitCheckoutAndSync() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    depends git
    local repository=${1}
    local branch=${2}
    local update=${3:-""}

    cd "${localWorkDir}/git/${repository}" || errorExit "Could not cd to ${localWorkDir}/git/${repository}"

    # Save current branch
    local startBranch=$(git branch --no-color | grep '\*' | awk '{print $2}')

    # Checkout correct branch
    foldIt "-n" "Checkout branch ${branch}"
    if git checkout "${branch}" -q; then
        ok
        dbg "Checked out branch ${branch}"
    else
        failed "Could not checkout branch ${branch}"
    fi

    if [ -n "${update}" ]; then
        foldIt "-n" "Fast-forward branch ${branch}"
        if git merge -q --ff-only "@{upstream}"; then
            ok
            dbg "Fast-forwarded branch ${branch}"
        else
            failed "Could not fast-forward branch ${branch}"
        fi
    fi

    foldIt "-n" "Moving files to ${localWorkDir}"
    syncFiles "${localWorkDir}/git/${repository}" "${localWorkDir}/${repository}/${repository}-${branch}"
    saveRevision "${repository}" "${branch}" "$(git rev-parse HEAD)"

    # Restore staring branch
    foldIt "-n" "Restoring original branch ${startBranch}"
    if git checkout "${startBranch}" -q; then
        ok
        dbg "Checked out branch ${startBranch}"
    else
        failed "Could not checkout branch ${startBranch}"
    fi

    cd "${myStartDirectory}" || errorExit "Could not cd to ${myStartDirectory}"

    dbg "${FUNCNAME}() leaving function"
}

# Make a backup of a file that is about to be replaced.
# Arg: dir file
backupFile() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local toDir=${1}
    local file=${2}
    # Backups from the same run are grouped under one timestamp directory and mirror
    # ${toDir}, so same-named files from different directories can't collide or overwrite
    # each other, and the original filename (dotfile or not) is kept intact.
    local backupFile="${localWorkDir}/backup/${backupTimestamp}${toDir}/${file}"
    createDir "${backupFile%/*}"
    if cp -p "${toDir}/${file}" "${backupFile}"; then
        ok
        dbg "Backed up: ${backupFile}"
        # Visible (non-hidden) index of every file backed up this run, so
        # dotfiles aren't missed when just browsing with plain "ls".
        echo "${toDir}/${file}" >>"${localWorkDir}/backup/${backupTimestamp}/index"
    else
        ncfailed
    fi
    dbg "${FUNCNAME}() leaving function"
}

# Save the revision a repository branch was synced from, used in file headers.
# Arg: repository branch revision
saveRevision() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    createDir -q -f "${localWorkDir}/revisions"
    echo "${3}" >"${localWorkDir}/revisions/${1}-${2}"
    dbg "${FUNCNAME}() leaving function"
}

# Print ${infile} to stdout. The first comment line with ${headerKeyword} is replaced
# with a header, keeping the indentation and comment characters before (and after,
# e.g. "-->") it:
#   # %%GET_ENV%%      " %%GET_ENV%%      <!-- %%GET_ENV%% -->
# Every header line contains the keyword, so "diff -I" can ignore the header.
# Arg: infile path_in_repo
catWithHeader() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local infile=${1}
    local relPath=${2}
    # Comment characters are punctuation only, so code like kw="%%GET_ENV%%" is not a match.
    local headerLine="^([[:space:]]*)([^[:alnum:][:space:]]+)[[:space:]]*${headerKeyword}[[:space:]]*([^[:alnum:][:space:]]*)[[:space:]]*$"
    local lineNumber=""
    local line=""
    local indent=""
    local commentStart=""
    local commentEnd=""
    local revision="unknown"
    local text=""

    # -I skips binary files
    lineNumber=$(grep -n -m 1 -I -E "${headerLine}" "${infile}" | cut -d: -f1)
    if [ -z "${lineNumber}" ]; then
        dbg "No header line in ${infile}"
        cat "${infile}"
        return
    fi
    line=$(sed -n "${lineNumber}p" "${infile}")
    [[ "${line}" =~ ${headerLine} ]]
    indent=${BASH_REMATCH[1]}
    commentStart=${BASH_REMATCH[2]}
    commentEnd=${BASH_REMATCH[3]:+ ${BASH_REMATCH[3]}}
    if [ -r "${localWorkDir}/revisions/${repository}-${branch}" ]; then
        revision=$(cut -c 1-7 "${localWorkDir}/revisions/${repository}-${branch}")
    fi

    head -n $((lineNumber - 1)) "${infile}"
    for text in \
        "" \
        " This file is handled by ${myName}. Local changes will be lost." \
        " Source: ${repository} (branch ${branch}): ${relPath#./}" \
        " Put on disk: $(date +"${dateFormat}") by ${myName} on ${HOSTNAME}" \
        " git revision: ${revision}" \
        ""; do
        echo "${indent}${commentStart} ${headerKeyword}${text}${commentEnd}"
    done
    tail -n +$((lineNumber + 1)) "${infile}"
    dbg "${FUNCNAME}() leaving function"
}

# Files that shall be copied
# Arg: dir_in_repo dir_to_be_moved_to _files_
copyFiles() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local fromDir=${1}
    shift
    local toDir=${1}
    shift
    local file=""
    local sourceFile=""
    local copyFrom=""
    local withHeader=""
    # Test if ${toDir} exists
    createDir "${toDir}"

    for file in "$@"; do
        sourceFile="${localWorkDir}/${repository}/${repository}-${branch}/${fromDir}/${file}"
        # Test if the source file exists
        if [ ! -f "${sourceFile}" ]; then
            foldIt "-n" "Checking for file ${file}"
            failed "File does not exists: ${sourceFile}"
        fi
        # Files with ${headerKeyword} get a header. Build it in a temporary copy (cp -p
        # keeps the mode), and ignore the header lines when comparing, since the
        # header has a timestamp that differs every run.
        copyFrom="${sourceFile}"
        withHeader=""
        if grep -q -I -F "${headerKeyword}" "${sourceFile}"; then
            withHeader="yes"
            copyFrom=$(mktemp "${downloadDir}/header.XXXXXX")
            cp -p "${sourceFile}" "${copyFrom}"
            catWithHeader "${sourceFile}" "${fromDir}/${file}" >"${copyFrom}"
        fi
        # If the destination file exist ...
        if [ -f "${toDir}/${file}" ]; then
            # .. diff it with the source file
            # A header added to an already deployed file is only header lines, which
            # "diff -I" ignores, so also update if the deployed file lacks the header.
            if ! diff -q ${withHeader:+-I "${headerKeyword}"} "${copyFrom}" "${toDir}/${file}" >/dev/null 2>&1 ||
                { [ -n "${withHeader}" ] && ! grep -q -F "${headerKeyword}" "${toDir}/${file}"; }; then
                if [ -z "${dryrun}" ]; then
                    # .. And if it is not the same, copy to backup file.
                    foldIt "-n" "Found difference in ${toDir}/${file}, making backup"
                    backupFile "${toDir}" "${file}"
                fi
                # .. Copy the new file
                foldIt "-n" "Copy new ${toDir}/${file}"
                if [ -n "${dryrun}" ]; then
                    dryRun
                    dryrunUpdatedFiles="${dryrunUpdatedFiles}${file} "
                else
                    if cp "${copyFrom}" "${toDir}/${file}"; then
                        ok
                        dbg "Updated file: ${toDir}/${file} copied ok"
                        updatedFiles="${updatedFiles}${file} "
                    else
                        failed "Could not copy ${sourceFile} to ${toDir}/${file}"
                    fi
                fi
            else
                dbg "${file} are up to date"
            fi
        # If the to_file dose not exist, just copy it.
        else
            foldIt "-n" "Copy new ${toDir}/${file}"
            if [ -n "${dryrun}" ]; then
                dryRun
                dryrunNewFiles="${dryrunNewFiles}${file} "
            else
                if cp "${copyFrom}" "${toDir}/${file}" >/dev/null 2>&1; then
                    ok
                    dbg "New file: ${toDir}/${file} copied ok"
                    newFiles="${newFiles}${file} "
                else
                    failed "Could not copy ${sourceFile} to ${toDir}/${file}"
                fi
            fi
        fi
    done
    dbg "${FUNCNAME}() leaving function"
}

# Files that shall be symlinked from the repository instead of copied
# Arg: dir_in_repo dir_to_link_from _files_
linkFiles() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local fromDir=${1}
    shift
    local toDir=${1}
    shift
    local file=""
    local target=""
    # Test if ${toDir} exists
    createDir "${toDir}"

    for file in "$@"; do
        # Links point into the synced copy, not the git clone, so they work with both
        # github and own git server and survive syncFiles() updating the files.
        target="${localWorkDir}/${repository}/${repository}-${branch}/${fromDir}/${file}"
        # Test if the source file exists
        if [ ! -f "${target}" ]; then
            foldIt "-n" "Checking for file ${file}"
            failed "File does not exists: ${target}"
        fi
        if [ -L "${toDir}/${file}" ]; then
            # Already a link. Only replace it if it points elsewhere (e.g. other branch).
            if [ "$(readlink "${toDir}/${file}")" = "${target}" ]; then
                dbg "${toDir}/${file} already links to ${target}"
                continue
            fi
        elif [ -e "${toDir}/${file}" ]; then
            # A regular file is in the way, back it up before it is replaced by the link.
            if [ -z "${dryrun}" ]; then
                foldIt "-n" "Found file ${toDir}/${file}, making backup"
                backupFile "${toDir}" "${file}"
            fi
        fi
        foldIt "-n" "Link ${toDir}/${file}"
        if [ -n "${dryrun}" ]; then
            dryRun
            dryrunLinkedFiles="${dryrunLinkedFiles}${file} "
        else
            if ln -sfn "${target}" "${toDir}/${file}"; then
                ok
                dbg "Linked ${toDir}/${file} -> ${target}"
                linkedFiles="${linkedFiles}${file} "
            else
                failed "Could not link ${toDir}/${file} to ${target}"
            fi
        fi
    done
    dbg "${FUNCNAME}() leaving function"
}

