# Check that configuration files only have valid configurations.
# Arg: config-filetype [get_env|manifest] file
validateConfig() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local confType=${1}
    local confFile=${2}
    local badContent=""
    # grep exits 1 when every line is valid and 2 on error (e.g. a bad pattern).
    local grepStatus=0
    # Both files are sourced, so the whole line must match. A value is either quoted
    # (may contain spaces) or unquoted without spaces, since an unquoted space would
    # run the rest of the line as a command. Arg: allowed characters, without space
    # and "-" ("-" must be last in a bracket expression, or it is read as a range).
    confValue() { echo "('[${1} -]*'|\"[${1} -]*\"|[${1}-]*)( +#.*)?"; }
    local name="A-Za-z0-9._"
    local path="A-Za-z0-9/_~.\$"
    local number="(\"[0-9]*\"|'[0-9]*'|[0-9]*)"
    # "?", "=" and "&" only when quoted, an unquoted "&" runs the rest in background.
    local url="(\"[A-Za-z0-9/_~.:?=&%-]*\"|'[A-Za-z0-9/_~.:?=&%-]*'|[A-Za-z0-9/_~.:%-]*)"
    dbg "confType = ${confType}"
    case "${confType}" in
    "get_env")
        dbg "Validate type: get_env"
        badContent=$(grep -E -v \
            -e "^#" \
            -e "^$" \
            -e "^get_envGitServer=$(confValue "${name}")$" \
            -e "^get_envGitUser=$(confValue "${name}")$" \
            -e "^get_envRepository=$(confValue "${name}")$" \
            -e "^get_envBranch=$(confValue "${path}")$" \
            -e "^gitServer=$(confValue "${name}")$" \
            -e "^gitUser=$(confValue "${name}")$" \
            -e "^repository=$(confValue "${name}")$" \
            -e "^branch=$(confValue "${path}")$" \
            -e "^sshPort=${number}$" \
            -e "^pathToRepository=$(confValue "${path}")$" \
            -e "^localWorkDir=$(confValue "${path}")$" \
            -e "^backupKeepRuns=${number}$" \
            -e "^reportUrl=${url}$" \
            "${confFile}") || grepStatus=$?
        ;;
    "manifest")
        dbg "Validate type: manifest"
        badContent=$(grep -E -v \
            -e "^#" \
            -e "^$" \
            -e "^dirsToCreate=$(confValue "${path}")$" \
            -e "^files2copy[[][0-9]+[]]=$(confValue "${path}")$" \
            -e "^files2link[[][0-9]+[]]=$(confValue "${path}")$" \
            -e "^ignoreHosts=$(confValue "${path}")$" \
            "${confFile}") || grepStatus=$?
        ;;
    *)
        dbg "${confType} is not an valid confType."
        errorExit "Internal error. Run with -d to get more information."
        ;;
    esac
    # Fail closed: if grep itself failed, nothing was validated.
    if [ "${grepStatus}" -gt 1 ]; then
        errorExit "Could not validate ${confFile}. Run with -d to get more information."
    fi
    if [ -n "${badContent}" ]; then
        dbg "${confFile} is not sanitized: ${badContent}"
        errorExit "${confFile} contains bad things: ${badContent}"
    else
        dbg "${confFile} is sanitized, no bad content"
    fi
    dbg "${FUNCNAME}() leaving function"
}

# Test if there was a change in get_env - and is needed to be run again.
# Need absolute name in from file, so it truly can make variable name.
# This diff dose not care about comments.
get_envDiffAndRestart() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local get_envDownloaded="${localWorkDir}/${get_envRepository}/${get_envRepository}-${get_envBranch}/${myAbsoluteName}"
    if ! diff -q -I '^# .*' ~/"${myName}" "${get_envDownloaded}" >/dev/null 2>&1; then
        foldIt "-e" "${info}Found newer ${myName}${end}"
        if [ -n "${noGet_envUpdate}" ] || [ -n "${dryrun}" ]; then
            dbg "${noGet_envUpdate} ${dryrun} is set, don't replace or run newer"
            foldIt "Do not run newer ${myName}, ${noGet_envUpdate} ${dryrun} is invoked."
        else
            foldIt "-en" "Replacing       $HOME/${myName}"
            if cp "${get_envDownloaded}" ~/"${myName}"; then
                ok
                dbg "Replaced ${myName} with newer successfully."
            else
                failed "Could not copy the file ${myAbsoluteName} to ${myName}"
            fi
            foldIt "-e" "${info}Executing new $HOME/${myName}${end}"
            bar
            foldIt ""
            foldIt ""
            stars
            foldIt ""
            foldIt ""
            # Makes next script start with debug if this instance was started with debug.
            if [ -n "${debug}" ]; then
                cleanup
                exec ~/"${myName}" -r "${localWorkDir}" "${quietMode}" "${noGet_envUpdate}" "${debug}" -l "${debugLog}"
            else
                cleanup
                exec ~/"${myName}" -r "${localWorkDir}" "${quietMode}" "${noGet_envUpdate}"
            fi
        fi
    else
        foldIt "Already running latest ${myName}"
    fi
    dbg "${FUNCNAME}() leaving function"
}

# Make ${destDir} an exact copy of ${sourceDir} (without .git), so files removed from
# the repository are removed from the copy as well. Copies to a new directory and
# swaps it in, the path stays the same so links into it keep working.
# Only used for get_env's own copies of repositories, never for destinations of
# files from the manifest, so it refuses to touch anything outside ${localWorkDir}.
# Arg: sourceDir destDir
syncFiles() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    local sourceDir=${1%/}
    local destDir=${2%/}
    local newDir="${destDir}.new"
    local oldDir="${destDir}.old"
    if [ ! -d "${sourceDir}" ]; then
        errorExit "${sourceDir} does not exists."
    fi
    # Guard for the rm -rf below.
    case "${destDir}" in
    */../* | */..)
        errorExit "Refusing to sync to ${destDir}, path contains .."
        ;;
    "${localWorkDir}"/?*) ;;
    *)
        errorExit "Refusing to sync to ${destDir}, not in ${localWorkDir}"
        ;;
    esac

    # Leftovers from an interrupted run.
    rm -rf "${newDir}" "${oldDir}"
    mkdir -p "${destDir%/*}" || failed "Failed to create ${destDir%/*}"
    # cp -p keeps modes, so scripts stay executable.
    if ! cp -R -p "${sourceDir}" "${newDir}"; then
        rm -rf "${newDir}"
        failed "Failed to copy ${sourceDir} to ${newDir}"
    fi
    rm -rf "${newDir}/.git"
    if [ -d "${destDir}" ]; then
        mv "${destDir}" "${oldDir}" || failed "Failed to move ${destDir} to ${oldDir}"
    fi
    if mv "${newDir}" "${destDir}"; then
        ok
        dbg "Synced ${sourceDir} to ${destDir}"
    else
        failed "Failed to move ${newDir} to ${destDir}"
    fi
    rm -rf "${oldDir}"
    dbg "${FUNCNAME}() leaving function"
}

# Removes the oldest backup run directories (see copyFiles()) beyond ${backupKeepRuns}.
# Disabled (keeps everything, forever) unless backupKeepRuns is set in confFile, since
# it defaults to empty.
rotateBackups() {
    dbg "${FUNCNAME}() was called, arg: ${*}"
    if [ -z "${backupKeepRuns:-}" ]; then
        dbg "\${backupKeepRuns} not set, not rotating backups"
        return 0
    fi
    if [ -z "${localWorkDir:-}" ]; then
        dbg "\${localWorkDir} not set, not rotating backups"
        return 0
    fi
    local backupDir="${localWorkDir}/backup"
    if [ ! -d "${backupDir}" ]; then
        dbg "${backupDir} does not exist, nothing to rotate"
        return 0
    fi

    local runs=()
    local run=""
    # Glob expansion is sorted, and run directories are named after a sortable
    # timestamp (see ${backupTimestamp}), so this is oldest-to-newest.
    for run in "${backupDir}"/*/; do
        # Without any match the pattern itself is returned.
        [ -d "${run}" ] || continue
        run=${run%/}
        runs+=("${run##*/}")
    done

    local numberOfRuns=${#runs[@]}
    if [ "${numberOfRuns}" -le "${backupKeepRuns}" ]; then
        dbg "${numberOfRuns} backup run(s), \${backupKeepRuns} is ${backupKeepRuns}, nothing to rotate"
        return 0
    fi

    local numberToRemove=$((numberOfRuns - backupKeepRuns))
    local i=0
    for ((i = 0; i < numberToRemove; i++)); do
        foldIt "-n" "Removing old backup run ${backupDir}/${runs[${i}]}"
        if rm -r "${backupDir:?}/${runs[${i}]}"; then
            ok
            dbg "Removed old backup run: ${backupDir}/${runs[${i}]}"
        else
            ncfailed
        fi
    done
    dbg "${FUNCNAME}() leaving function"
}

# shellcheck disable=SC2120 # Arguments are optional and not used.
